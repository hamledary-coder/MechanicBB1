<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardLog"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#F1FCFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ====== هدر (سه سطر) ====== -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <!-- سطر ۱: شماره گزارش -->
            <TextView
                android:id="@+id/tvLogNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 گزارش #۱"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="4dp"
                tools:ignore="HardcodedText" />

            <!-- سطر ۲: تاریخ + روز هفته -->
            <TextView
                android:id="@+id/tvLogDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 1405/08/19 (شنبه)"
                android:textSize="16sp"
                android:textColor="#333"
                android:layout_marginBottom="4dp"
                tools:ignore="HardcodedText" />

            <!-- سطر ۳: ساعت + مسئول -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLogTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰ 09:00 - 11:00"
                    android:textSize="12sp"
                    android:textColor="#666"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  |  "
                    android:textSize="12sp"
                    android:textColor="#CCCCCC"
                    android:layout_marginHorizontal="4dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvLogUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👤 علی رضایی"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- ====== جزئیات ====== -->
        <LinearLayout
            android:id="@+id/detailLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- شرح اقدام -->
            <TextView
                android:id="@+id/tvActionDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="شرح اقدام: ..."
                android:textSize="16sp"
                android:textColor="#000000"
                android:background="#FFE8E7"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:lineSpacingExtra="4dp"
                tools:ignore="HardcodedText" />

            <View
                android:id="@+id/dividerDescription"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8E8E8"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏱ مدت زمان: ..."
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvWorkers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 گروه انجام‌دهنده: ..."
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <View
                android:id="@+id/dividerWorkers"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8E8E8"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/statusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/circle_indicator"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvNewStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="وضعیت جدید: ..."
                    android:textSize="13sp"
                    android:textColor="#555555"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <View
                android:id="@+id/dividerSeenBy"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8E8E8"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- ====== ارزیابی (اکسپندبل) ====== -->
            <LinearLayout
                android:id="@+id/evaluationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/evaluationHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="#F5F5F5"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvEvaluationTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 ارزیابی گزارش"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#555555"
                        tools:ignore="HardcodedText" />

                    <ImageView
                        android:id="@+id/ivEvaluationExpand"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="#888888"
                        tools:ignore="ContentDescription" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/evaluationDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="#FAFAFA"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvHeatLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌡️ دمای هوا: ..."
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvPollutionLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏭 میزان آلودگی: ..."
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvPhysicalDifficulty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💪 سختی فیزیکی: ..."
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvTechnicalComplexity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔧 پیچیدگی فنی: ..."
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <View
                    android:id="@+id/dividerEvaluation"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8E8E8"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ====== نظرات ====== -->
            <TextView
                android:id="@+id/tvCommentLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 نظرات:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#37474F"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAddComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➕ ثبت نظر"
                android:backgroundTint="#689F38"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <View
                android:id="@+id/dividerButtons"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8E8E8"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- ====== دکمه‌های عملیاتی ====== -->
            <LinearLayout
                android:id="@+id/actionButtonsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnEvaluate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⭐ ارزیابی"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#303F9F"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"
                    tools:ignore="ButtonStyle,HardcodedText" />

                <Button
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✏️ ویرایش"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FBC02D"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🗑️ حذف"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#C62828"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- مشاهده‌کنندگان -->
            <LinearLayout
                android:id="@+id/seenByContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>