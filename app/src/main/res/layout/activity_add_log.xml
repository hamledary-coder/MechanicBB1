<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ====== Toolbar ====== -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_blue"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="@android:color/white"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:fillViewport="true"
        android:layoutDirection="rtl">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ====== کارت 1: زمان و تاریخ ====== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 زمان و تاریخ"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="12dp" />

                <!-- تاریخ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تاریخ انجام *"
                    android:textSize="12sp"
                    android:textColor="#999"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="۱۴۰۴/۰۲/۲۵"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:background="@drawable/bg_edittext_rounded"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- زمان شروع و پایان -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="زمان شروع"
                            android:textSize="12sp"
                            android:textColor="#999"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etStartTime"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="۰۹:۰۰"
                            android:focusable="false"
                            android:cursorVisible="false"
                            android:background="@drawable/bg_edittext_rounded"
                            android:padding="12dp"
                            android:gravity="center" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="زمان پایان"
                            android:textSize="12sp"
                            android:textColor="#999"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etEndTime"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="۱۲:۰۰"
                            android:focusable="false"
                            android:cursorVisible="false"
                            android:background="@drawable/bg_edittext_rounded"
                            android:padding="12dp"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

                <!-- مدت زمان -->
                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ مدت زمان: ۰ ساعت و ۰ دقیقه"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:padding="8dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ====== کارت 2: شرح اقدام ====== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 شرح اقدام *"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etActionDescription"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:hint="متن گزارش را وارد کنید..."
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:background="@drawable/bg_edittext_rounded"
                    android:padding="12dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ====== کارت 4: تیم اجرایی (اختیاری - جمع‌شونده) ====== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTeam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/headerTeam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="👥 تیم اجرایی"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#666" />

                    <ImageView
                        android:id="@+id/ivExpandTeam"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_down"
                        android:rotation="0" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentTeam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:paddingTop="0dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvGroupValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="در حال بارگیری..."
                        android:textSize="14sp"
                        android:textColor="#333"
                        android:padding="12dp"
                        android:background="@drawable/bg_edittext_rounded"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnEditGroup"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="✏️ ویرایش گروه"
                        android:backgroundTint="#FF9800"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ====== دکمه ثبت اصلی ====== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📋 ثبت گزارش"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#2E7D32"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ====== کارت 6: توضیحات تکمیلی (اختیاری - جمع‌شونده) ====== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/headerNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📎 توضیحات تکمیلی"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#666" />

                    <ImageView
                        android:id="@+id/ivExpandNotes"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_down"
                        android:rotation="0" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:paddingTop="0dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etNotes"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="توضیحات اضافی..."
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:background="@drawable/bg_edittext_rounded"
                        android:padding="12dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- دکمه انصراف -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="انصراف"
            android:textSize="14sp"
            android:backgroundTint="#9E9E9E"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>

    </ScrollView>

</LinearLayout>