<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- سطر اول: نام روز + تاریخ + ساعت و کاربر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvDayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سه‌شنبه"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvLogDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۱۴۰۵/۰۴/۰۵"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  ۱۰:۳۰"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- نام کاربر -->
        <TextView
            android:id="@+id/tvLogUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="علی محمدی"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:background="@drawable/bg_user_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_gravity="end" />

    </LinearLayout>

    <!-- شرح اقدام -->
    <TextView
        android:id="@+id/tvLogAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="پمپ آب دستگاه تعویض شد و تست عملکرد انجام گرفت."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/divider_gradient" />

</LinearLayout>