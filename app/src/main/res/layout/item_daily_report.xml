<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ======== هدر ======== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@color/background_light">

            <TextView
                android:id="@+id/tvTaskId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="کار #1234"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="3 گزارش"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- عنوان کار -->
        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="عنوان کار"
            android:textColor="@android:color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- ======== شرح کار (با ظاهر متفاوت) ======== -->
        <TextView
            android:id="@+id/tvTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp"
            android:text="شرح کار"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone" />

        <!-- ======== ۱. گزارشات روز جاری (همیشه باز) ======== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingBottom="4dp"
            android:text="📋 گزارشات امروز:"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/currentDayLogsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp" />

        <!-- ======== خط جداکننده ======== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/divider_gradient" />

        <!-- ======== ۲. گزارشات روزهای قبل (بسته) ======== -->
        <!-- شمارشگر -->
        <TextView
            android:id="@+id/tvPreviousDaysSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="📜 ۳ گزارش از روزهای قبل"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- لیست گزارشات روزهای قبل (قابل Expand) -->
        <LinearLayout
            android:id="@+id/previousDaysContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/previousDaysListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- دکمه Expand -->
        <TextView
            android:id="@+id/btnExpand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▼ مشاهده گزارشات روزهای قبل"
            android:textColor="@color/primary_blue"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />

        <!-- ======== خط جداکننده ======== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/divider_gradient" />

        <!-- ======== ۳. لینک به جزئیات کامل (همیشه نمایش داده میشه) ======== -->
        <TextView
            android:id="@+id/btnViewDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مشاهده جزئیات کامل کار"
            android:textColor="@color/primary_blue"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</androidx.cardview.widget.CardView>