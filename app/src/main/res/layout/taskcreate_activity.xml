<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <!-- ✅ Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#2E7D32"
        app:title="ثبت کار جدید"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:navigationIconTint="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- عنوان کار -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 عنوان کار"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="مثال: تعمیر پمپ P-101"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="16dp" />

            <!-- توضیحات -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 توضیحات"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etTaskDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="توضیحات کار..."
                android:gravity="top|start"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp" />

            <!-- تاریخ برنامه‌ریزی -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 تاریخ برنامه‌ریزی (اختیاری)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etScheduledDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="مثال: 1405/08/09"
                    android:padding="12dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@android:drawable/edit_text" />

                <ImageButton
                    android:id="@+id/btnScheduledDatePicker"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_today"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="انتخاب تاریخ" />
            </LinearLayout>

            <!-- فوریت -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ فوریت"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rgUrgency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbUrgencyNormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="عادی" />

                <RadioButton
                    android:id="@+id/rbUrgencyHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="زیاد" />

                <RadioButton
                    android:id="@+id/rbUrgencyVeryHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="خیلی زیاد" />
            </RadioGroup>

            <!-- اولویت -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 اولویت"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPriority"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:stepSize="5"
                    android:value="50" />

                <TextView
                    android:id="@+id/tvPriorityValue"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="50"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#1565C0" />
            </LinearLayout>

            <!-- انتخاب WorkOrderها -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔗 درخواست‌های مرتبط (اختیاری)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvWorkOrdersSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="هیچ درخواستی انتخاب نشده"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:textColor="#666" />

                <Button
                    android:id="@+id/btnPickWorkOrders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="انتخاب"
                    android:backgroundTint="#2196F3" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- دکمه ثبت -->
    <Button
        android:id="@+id/btnSubmitTask"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#2E7D32"
        android:text="ثبت کار"
        android:textSize="18sp"
        android:textStyle="bold"/>

</LinearLayout>