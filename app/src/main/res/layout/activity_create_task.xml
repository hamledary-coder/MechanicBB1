<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ثبت دستور کار جدید"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/tvTaskNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="شماره کار: در حال تولید..."
                android:layout_marginBottom="15dp"
                android:textSize="14sp"
                android:textColor="#666"/>

            <!-- 1. عنوان (اجباری) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عنوان کار *"
                android:textSize="14sp"
                android:textColor="#2E7D32"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:padding="12dp"
                android:hint="مثال: رفع اشکال پمپ TA "
                android:background="@android:drawable/editbox_background"/>

            <!-- 2. شرح درخواست -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="شرح درخواست"
                android:textSize="14sp"
                android:textColor="#2E7D32"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etTaskDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="15dp"
                android:padding="12dp"
                android:hint="توضیحات کامل..."
                android:gravity="top"
                android:inputType="textMultiLine"
                android:background="@android:drawable/editbox_background"/>

            <!-- 3. واحد مربوطه -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="واحد مربوطه"
                android:textSize="14sp"
                android:textColor="#2E7D32"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerUnit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background"
                android:padding="8dp"
                android:layout_marginBottom="8dp"/>

            <!-- زیرمجموعه (فقط برای مجموعه‌ها) -->
            <LinearLayout
                android:id="@+id/layoutSubUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="زیرمجموعه"
                    android:textSize="14sp"
                    android:textColor="#2E7D32"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spinnerSubUnit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>

            <!-- 4. نحوه اعلام درخواست -->
            <LinearLayout
                android:id="@+id/layoutDeclarationMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نحوه اعلام درخواست:"
                    android:textSize="14sp"
                    android:textColor="#2E7D32"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spinnerDeclarationMethod"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>


            <!-- شماره درخواست سامانه (فقط برای سامانه تعمیرات) -->
            <LinearLayout
                android:id="@+id/layoutSystemNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="شماره درخواست سامانه"
                    android:textSize="14sp"
                    android:textColor="#2E7D32"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etSystemRequestNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:hint="مثال: 12345"
                    android:inputType="number"
                    android:background="@android:drawable/editbox_background"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>

            <!-- 5. صادرکننده درخواست -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="صادرکننده درخواست"
                android:textSize="14sp"
                android:textColor="#2E7D32"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etRequester"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:hint="نام و نام خانوادگی درخواست‌دهنده"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="8dp"/>

            <!-- 6. تاریخ اعلام کار -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تاریخ اعلام کار"
                android:textSize="14sp"
                android:textColor="#2E7D32"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etRequestDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:hint="۱۴۰۴/۰۲/۱۸"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:background="@android:drawable/editbox_background"
                    android:layout_marginEnd="8dp"/>

                <ImageButton
                    android:id="@+id/btnCalendar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_today"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>

            <!-- 7.5 اولویت -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اولویت (0 تا 100)"
                android:textSize="14sp"
                android:textColor="#2E7D32"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPriority"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:stepSize="5"
                    android:value="50" />

                <TextView
                    android:id="@+id/tvPriorityValue"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="50"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 7. فوریت انجام -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="فوریت انجام"
                android:textSize="14sp"
                android:textColor="#2E7D32"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <RadioGroup
                android:id="@+id/rgUrgency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbUrgencyNormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="عادی"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbUrgencyHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="زیاد"/>

                <RadioButton
                    android:id="@+id/rbUrgencyVeryHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="خیلی زیاد"/>
            </RadioGroup>

            <!-- 8. بررسی اولیه -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="بررسی اولیه"
                android:textSize="14sp"
                android:textColor="#2E7D32"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etInitialReview"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:padding="12dp"
                android:hint="نتایج بررسی اولیه را وارد کنید..."
                android:gravity="top"
                android:inputType="textMultiLine"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- دکمه ثبت ثابت در پایین -->
    <Button
        android:id="@+id/btnSubmitTask"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:backgroundTint="#2E7D32"
        android:text="ثبت کار"
        android:textSize="18sp"
        android:textStyle="bold"/>

</LinearLayout>