<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- ✅ بولت رنگی (سمت راست توی RTL) -->
        <View
            android:id="@+id/woColorBullet"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#2196F3"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- عنوان (تمام عرض، ۲ خط) -->
            <TextView
                android:id="@+id/tvWoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعویض پایلوت فلر"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="8dp" />

            <!-- کلاس + واحد + پیشرفت + حذف -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvWoClass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="کلاس ۱۴"
                    android:textSize="11sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/tvWoUnit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=" | بهره‌برداری"
                    android:textSize="11sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/tvWoProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="۷۰٪"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32" />

                <!-- دکمه حذف (فقط CreateTaskActivity) -->
                <ImageView
                    android:id="@+id/ivRemoveWo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="حذف"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>