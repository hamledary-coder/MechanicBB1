<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- دکمه ثبت گزارش -->
    <Button
        android:id="@+id/btnAddLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ثبت گزارش جدید"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#9C27B0" />

    <!-- سه تا دکمه وضعیت -->
    <LinearLayout
        android:id="@+id/statusButtonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="ادامه دارد"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1565C0"
            app:cornerRadius="10dp"
            app:elevation="4dp"
            app:rippleColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusBlocked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="متوقف"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#C62828"
            app:cornerRadius="10dp"
            app:elevation="4dp"
            app:rippleColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusComplete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="اتمام کار"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="10dp"
            app:elevation="4dp"
            app:rippleColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>