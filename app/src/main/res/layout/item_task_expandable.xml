<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <!-- استفاده از LinearLayout به عنوان ریشه برای چینش عمودی -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ✅ نوار بالایی (برای فوریت و وضعیت 41 کارمند) -->
        <View
            android:id="@+id/topColorStrip"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:visibility="gone" />

        <!-- محتوای اصلی با نوار سمت راست -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- نوار رنگی (سمت راست) -->
            <View
                android:id="@+id/colorStrip"
                android:layout_width="6dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="#E0E0E0"/>

            <!-- بقیه محتوا -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:id="@+id/headerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivExpand"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_down"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tvTaskTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="عنوان کار"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:maxLines="2"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tvTaskId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#123"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#666"
                        android:layout_marginEnd="12dp"/>

                </LinearLayout>

                <!-- دیوایدر هدر -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/divider_gradient"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:visibility="gone"/>

                <!-- Detail Layout -->
                <LinearLayout
                    android:id="@+id/detailLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#F5F5F5"
                    android:visibility="gone">


                <!-- توضیحات -->
                <TextView
                    android:id="@+id/tvTaskDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="توضیحات..."
                    android:textSize="13sp"
                    android:textColor="#555"
                    android:layout_marginBottom="8dp" />

                <View
                    android:id="@+id/dividerDescription"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="8dp" />

                <!-- مسئول -->
                <TextView
                    android:id="@+id/tvTaskResponsible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مسئول: ..."
                    android:textSize="13sp"
                    android:textColor="#333"
                    android:layout_marginBottom="4dp" />

                <!-- انجام‌دهندگان -->
                <TextView
                    android:id="@+id/tvTaskAssignees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="گروه: ..."
                    android:textSize="13sp"
                    android:textColor="#333"
                    android:layout_marginBottom="4dp" />

                <View
                    android:id="@+id/dividerAssignee"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="8dp" />

                <!-- واحد -->
                <TextView
                    android:id="@+id/tvTaskUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="واحد: ..."
                    android:textSize="13sp"
                    android:textColor="#333"
                    android:layout_marginBottom="4dp" />

                <!-- اولویت/فوریت -->
                <TextView
                    android:id="@+id/tvTaskPriority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="فوریت: ..."
                    android:textSize="13sp"
                    android:textColor="#333"
                    android:layout_marginBottom="4dp" />

                <!-- تاریخ اعلام -->
                <TextView
                    android:id="@+id/tvRequestDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تاریخ اعلام: ..."
                    android:textSize="13sp"
                    android:textColor="#333"
                    android:layout_marginBottom="4dp" />

                <!-- صادرکننده -->
                <TextView
                    android:id="@+id/tvRequester"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="صادرکننده: ..."
                    android:textSize="13sp"
                    android:textColor="#333"
                    android:layout_marginBottom="4dp" />

                <!-- نحوه اعلام -->
                <TextView
                    android:id="@+id/tvDeclarationMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نحوه اعلام: ..."
                    android:textSize="13sp"
                    android:textColor="#333"
                    android:layout_marginBottom="4dp" />

                <!-- شماره سامانه -->
                <TextView
                    android:id="@+id/tvSystemNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="شماره سامانه: ..."
                    android:textSize="13sp"
                    android:textColor="#333"
                    android:layout_marginBottom="4dp" />

                <!-- بررسی اولیه -->
                <TextView
                    android:id="@+id/tvInitialReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="بررسی اولیه: ..."
                    android:textSize="13sp"
                    android:textColor="#333"
                    android:layout_marginBottom="8dp" />

                <!-- ===== جدول کارکرد نفرات ===== -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="8dp" />

                <!-- عنوان جدول کارکرد -->
                <TextView
                    android:id="@+id/tvPerformanceTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 کارکرد نفرات در این کار"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                    <!-- هدر جدول -->
                    <LinearLayout
                        android:id="@+id/tableHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#E8E8E8"
                        android:padding="8dp"
                        android:layout_marginBottom="4dp"
                        android:weightSum="4.5">  <!-- ← weightSum رو اضافه کن -->

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="نام"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#555" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:text="ساعت خام"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#555"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/headerResponsibility"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:text="مسئولیت"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:gravity="center"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/headerPhysical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:text="فیزیکی"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:gravity="center"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/headerTechnical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:text="فنی"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:gravity="center"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/headerInspection"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:text="بررسی"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:gravity="center"
                            android:visibility="gone" />

                    </LinearLayout>

                <!-- RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTaskPerformance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <!-- پیام خالی -->
                <TextView
                    android:id="@+id/tvEmptyPerformance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="هیچ داده‌ای برای این کار وجود ندارد"
                    android:textSize="12sp"
                    android:textColor="#888"
                    android:gravity="center"
                    android:padding="12dp"
                    android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
