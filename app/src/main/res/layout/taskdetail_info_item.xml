<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <View
        android:id="@+id/topColorStrip"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/colorStrip"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#E0E0E0"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ========== عنوان کار ========== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#E3F2FD"
                app:cardElevation="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📌"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvTaskTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="عنوان کار"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0" />

                    <TextView
                        android:id="@+id/tvTaskId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#123"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#1565C0"
                        android:background="#BBDEFB"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ========== بخش وضعیت ========== -->
            <LinearLayout
                android:id="@+id/statusSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#F5F5F5"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 وضعیت کار"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp" />

                <!-- عنوان وضعیت (بالای slider) -->
                <TextView
                    android:id="@+id/tvStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ادامه دارد"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_status_label"
                    android:layout_marginBottom="8dp" />

                <!-- Slider استاندارد -->
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="2"
                    android:stepSize="1"
                    android:value="0"
                    app:trackHeight="6dp"
                    app:trackColorActive="#1565C0"
                    app:trackColorInactive="#DDDDDD"
                    app:thumbRadius="18dp"
                    app:tickVisible="true"
                    app:tickColorActive="#1565C0"
                    app:tickColorInactive="#DDDDDD" />

                <!-- برچسب‌های زیر اسلایدر -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="متوقف"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:textColor="#C62828" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ادامه"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:textColor="#1565C0" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="اتمام"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:textColor="#2E7D32" />
                </LinearLayout>

            </LinearLayout>

            <!-- ========== scheduledDate + فوریت + اولویت ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/layoutScheduledDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 تاریخ برنامه‌ریزی: "
                        android:textSize="12sp"
                        android:textColor="#999" />

                    <TextView
                        android:id="@+id/tvScheduledDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="..."
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/layoutUrgency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ فوریت: "
                            android:textSize="12sp"
                            android:textColor="#999" />

                        <TextView
                            android:id="@+id/tvTaskUrgency"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="..."
                            android:textSize="13sp"
                            android:textColor="#333"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutPriority"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯 اولویت: "
                            android:textSize="12sp"
                            android:textColor="#999" />

                        <TextView
                            android:id="@+id/tvTaskPriority"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="50"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- ========== توضیحات ========== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#F5F5F5"
                app:cardElevation="0dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄 شرح کار"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#666"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvTaskDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="..."
                        android:textSize="14sp"
                        android:textColor="#444"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ========== مسئول + گروه + ارجاع‌دهنده ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/layoutResponsible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤 مسئول: "
                        android:textSize="12sp"
                        android:textColor="#999" />

                    <TextView
                        android:id="@+id/tvTaskResponsible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="..."
                        android:textSize="13sp"
                        android:textColor="#333"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutAssignees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👥 گروه: "
                        android:textSize="12sp"
                        android:textColor="#999" />

                    <TextView
                        android:id="@+id/tvTaskAssignees"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="..."
                        android:textSize="13sp"
                        android:textColor="#333" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutReferredBy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↩️ ارجاع‌دهنده: "
                        android:textSize="12sp"
                        android:textColor="#999" />

                    <TextView
                        android:id="@+id/tvReferredBy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="..."
                        android:textSize="13sp"
                        android:textColor="#333" />
                </LinearLayout>

            </LinearLayout>

            <!-- ========== WorkOrderها (بدون include) ========== -->
            <LinearLayout
                android:id="@+id/workOrdersSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#F5F5F5"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvWorkOrdersTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔗 درخواست‌های مرتبط"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWorkOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

            <!-- ========== برآورد اولیه ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#F5F5F5"
                app:cardElevation="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- هدر (قابل کلیک) -->
                    <LinearLayout
                        android:id="@+id/headerEstimate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📋 برآورد اولیه"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1565C0" />

                        <TextView
                            android:id="@+id/tvEstimateStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ثبت نشده"
                            android:textSize="11sp"
                            android:textColor="#999"
                            android:layout_marginEnd="8dp" />

                        <ImageView
                            android:id="@+id/ivExpandEstimate"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            android:rotation="0" />
                    </LinearLayout>

                    <!-- محتوا (باز/بسته) -->
                    <LinearLayout
                        android:id="@+id/contentEstimate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:paddingTop="0dp"
                        android:visibility="gone">

                        <!-- حالت خالی -->
                        <LinearLayout
                            android:id="@+id/layoutEstimateEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="⚠️ هنوز برآوردی ثبت نشده است"
                                android:textSize="13sp"
                                android:textColor="#FF9800"
                                android:layout_marginBottom="12dp" />

                            <Button
                                android:id="@+id/btnAddEstimateEmpty"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:text="+ افزودن برآورد"
                                android:backgroundTint="#2196F3"
                                android:textSize="13sp"
                                android:textColor="#FFFFFF"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- حالت پر -->
                        <LinearLayout
                            android:id="@+id/layoutEstimateData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <!-- نفرات + قسمت‌ها -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="👥 نفرات:"
                                    android:textSize="12sp"
                                    android:textColor="#666" />

                                <TextView
                                    android:id="@+id/tvEstimateManpower"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="1"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#333" />
                            </LinearLayout>

                            <!-- قسمت‌ها + ساعت -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="🔄 قسمت‌ها:"
                                    android:textSize="12sp"
                                    android:textColor="#666" />

                                <TextView
                                    android:id="@+id/tvEstimateParts"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="1 × 1 ساعت"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#333" />
                            </LinearLayout>

                            <!-- کل بازه -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="📊 کل بازه:"
                                    android:textSize="12sp"
                                    android:textColor="#666" />

                                <TextView
                                    android:id="@+id/tvEstimateTotalHours"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="1 ساعت"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#1565C0" />
                            </LinearLayout>

                            <!-- نفر-ساعت -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="🧮 نفر-ساعت:"
                                    android:textSize="12sp"
                                    android:textColor="#666" />

                                <TextView
                                    android:id="@+id/tvEstimateManHours"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="1"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#2E7D32" />
                            </LinearLayout>

                            <!-- نوع کار -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="🔧 نوع کار:"
                                    android:textSize="12sp"
                                    android:textColor="#666" />

                                <TextView
                                    android:id="@+id/tvEstimateWorkType"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="تجهیزات ثابت"
                                    android:textSize="13sp"
                                    android:textColor="#333" />
                            </LinearLayout>

                            <!-- سختی / پیچیدگی -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="💪 سختی:"
                                    android:textSize="12sp"
                                    android:textColor="#666" />

                                <TextView
                                    android:id="@+id/tvEstimatePhysical"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="3/5"
                                    android:textSize="13sp"
                                    android:textColor="#333" />
                            </LinearLayout>

                            <!-- دما / آلودگی -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="🌡️ دما/آلودگی:"
                                    android:textSize="12sp"
                                    android:textColor="#666" />

                                <TextView
                                    android:id="@+id/tvEstimateConditions"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="40°C / 20 ppm"
                                    android:textSize="13sp"
                                    android:textColor="#333" />
                            </LinearLayout>

                            <!-- یادداشت -->
                            <TextView
                                android:id="@+id/tvEstimateNotes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="#555"
                                android:layout_marginTop="6dp"
                                android:visibility="gone" />

                            <!-- ثبت‌کننده -->
                            <TextView
                                android:id="@+id/tvEstimateMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="📅 1405/08/09 — سرشیفت: نام"
                                android:textSize="11sp"
                                android:textColor="#999"
                                android:layout_marginTop="8dp" />

                            <!-- دکمه‌ها -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">

                                <Button
                                    android:id="@+id/btnAddEstimate"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="4dp"
                                    android:text="+ افزودن (بازنگری)"
                                    android:backgroundTint="#2196F3"
                                    android:textSize="12sp"
                                    android:textColor="#FFFFFF"
                                    android:visibility="gone" />

                                <Button
                                    android:id="@+id/btnDeleteEstimate"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:text="🗑 حذف"
                                    android:backgroundTint="#F44336"
                                    android:textSize="12sp"
                                    android:textColor="#FFFFFF"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== مشاهده‌کنندگان ========== -->
            <LinearLayout
                android:id="@+id/seenByContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- ========== دکمه‌های عملیات ========== -->
            <LinearLayout
                android:id="@+id/taskActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnEditTask"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_edit"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="#9C27B0"
                    android:contentDescription="ویرایش"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnDeleteTask"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_delete"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="#F44336"
                    android:contentDescription="حذف"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnReferTask"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_refer"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="#2196F3"
                    android:contentDescription="ارجاع"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    app:tint="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>